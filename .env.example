# Browser-safe Supabase connection
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Never expose in the browser.
SUPABASE_SECRET_KEY=
# Used only for applying migrations and database administration. Never expose in Vercel client settings.
SUPABASE_DB_URL=

# Google Drive / Google Cloud
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Use a local credential file during development. On Vercel, use the JSON value below.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Product defaults
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_USER_STORAGE_LIMIT_BYTES=250000000
